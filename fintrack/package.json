{
  "name": "fintrack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "cd backend ; npm run dev",
    "client": "cd frontend ; npm start",
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm run server\" \"npm run client\"",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}